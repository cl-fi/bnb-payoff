# Network & Chain (BNB Smart Chain Testnet - Chain ID 97)
CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Deployed BNB Smart Chain Testnet Contracts
USDT_ADDRESS=
VAULT_ADDRESS=
LENS_ADDRESS=
SETTLEMENT_ORACLE_ADDRESS=
DEPLOYMENT_BLOCK=

# Atlas Enterprise Oracle (server-side only — never expose API keys to packages/web)
ATLAS_API_KEY=
ATLAS_BTC_FEED_ID=626
ATLAS_ETH_FEED_ID=632
ENABLE_LIVE_ATLAS=true
ENABLE_BINANCE_KLINES=true

# Protocol Economics (hard-capped <= 500 bps open / <= 100 bps close on-chain)
PROTOCOL_FEE_BPS=400
CLOSE_FEE_BPS=0

# Server & PostgreSQL
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
POLL_INTERVAL_MS=5000
POSTGRES_USER=payoff
POSTGRES_PASSWORD=payoff_dev_secret
POSTGRES_DB=payoff
DATABASE_URL=postgres://payoff:payoff_dev_secret@127.0.0.1:5432/payoff

# Wallet, Market Maker & Explorer Verification Keys (never commit real keys!)
TESTNET_WALLET_PK=
PAUSER_PRIVATE_KEY=
ORACLE_PAUSER_ADDRESS=
MM1_PRIVATE_KEY=
MM2_PRIVATE_KEY=
MM3_PRIVATE_KEY=
FEE_RECIPIENT_ADDRESS=
BSCSCAN_API_KEY=

# Frontend (optional for split-origin deployment & mobile WalletConnect)
